{
  "name": "ae2-inventory-dashboard-web",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "node tools/browser.mjs test",
    "browser:install": "node tools/browser.mjs install chromium",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "format": "prettier --write src tests *.ts *.json index.html"
  },
  "dependencies": {
    "vue": "3.5.44",
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.4",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "prettier": "3.9.9"
  }
}
